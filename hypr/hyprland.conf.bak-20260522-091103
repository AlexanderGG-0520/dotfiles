# ===== Alex new floating rules =====
# Common dialogs
windowrule = match:title ^(Open File).*$, float 1, center 1
windowrule = match:title ^(Save File).*$, float 1, center 1
windowrule = match:title ^(Select a File).*$, float 1, center 1
windowrule = match:title ^(Choose Files).*$, float 1, center 1
windowrule = match:title ^(File Upload).*$, float 1, center 1
windowrule = match:title ^(Authentication Required).*$, float 1, center 1
windowrule = match:title ^(Password Required).*$, float 1, center 1

# Utility windows
windowrule = match:class ^(pavucontrol)$, float 1, center 1, size 760 520
windowrule = match:class ^(blueman-manager)$, float 1, center 1, size 760 520
windowrule = match:class ^(nm-connection-editor)$, float 1, center 1, size 760 540

# Picture in Picture
windowrule = match:title ^(Picture-in-Picture)$, float 1, pin 1, keep_aspect_ratio 1, size 400 225, move 100%-430 100%-260

