* {
  bg: #06111d;
  bg-alt: #0b1623;
  bg-soft: #111c2c;
  fg: #e4ebf3;
  muted: #93a4b7;
  border: #24384b;
  border-soft: #162536;
  selected: #122334;
  selected-border: #30465d;
}

window {
  location: center;
  anchor: center;
  width: 456px;
  border: 1px;
  border-color: @border;
  border-radius: 20px;
  background-color: @bg;
}

mainbox {
  children: [listview];
  padding: 12px;
  spacing: 0px;
  background-color: @bg;
}

inputbar {
  enabled: false;
}

prompt {
  enabled: false;
}

entry {
  enabled: false;
}

case-indicator {
  enabled: false;
}

mode-switcher {
  enabled: false;
}

message {
  enabled: false;
}

listview {
  columns: 3;
  lines: 2;
  fixed-height: true;
  fixed-columns: true;
  scrollbar: false;
  layout: vertical;
  spacing: 9px;
  background-color: transparent;
}

element {
  orientation: horizontal;
  children: [element-text];
  border: 1px;
  border-color: @border-soft;
  border-radius: 14px;
  background-color: @bg-alt;
  text-color: @fg;
  padding: 14px 12px;
}

element normal.normal {
  background-color: @bg-alt;
  border-color: @border-soft;
  text-color: @fg;
}

element alternate.normal {
  background-color: @bg-alt;
  border-color: @border-soft;
  text-color: @fg;
}

element selected.normal {
  background-color: #0e1b29;
  border-color: #39546d;
  text-color: @fg;
}

element-icon {
  enabled: false;
}

element-index {
  enabled: false;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}
